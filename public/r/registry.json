{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "portfolio",
  "homepage": "https://github.com/kostyniuk/portfolio",
  "items": [
    {
      "name": "viewport-reveal",
      "type": "registry:item",
      "title": "Viewport Reveal",
      "description": "A page-scoped scroll-driven reveal that fades and lifts content in while entering the viewport, then fades and lifts it out while leaving.",
      "css": {
        "@layer base": {
          ".page-reveal :where(h1, h2, h3, h4, h5, h6, p, li, blockquote, figcaption, a, button, img, picture, video, canvas, svg[role=\"img\"], [data-slot=\"badge\"], [data-slot=\"button\"], [data-slot=\"card\"], [data-slot=\"liquid-metal-card\"], [data-slot=\"card-title\"], [data-slot=\"card-description\"], [data-slot=\"card-content\"], [data-slot=\"item\"], [data-slot=\"item-media\"], [data-slot=\"item-title\"], [data-slot=\"item-description\"], [data-slot=\"avatar\"], [data-slot=\"avatar-image\"], [data-slot=\"avatar-badge\"], [data-slot=\"accordion-trigger\"], [data-slot=\"accordion-content\"], [data-slot=\"switch\"], [data-slot=\"kbd\"], [data-slot=\"frost-glass\"], [data-slot=\"shiny-text\"], [data-slot=\"electric-border\"], [data-slot=\"contribution-graph\"], [data-slot=\"contribution-graph-calendar\"], [data-slot=\"contribution-graph-footer\"], [data-slot=\"preference-group\"], [data-slot=\"preference-bar\"], [data-slot=\"preference-item\"])": {
            "animation": "viewport-reveal linear both",
            "animation-timeline": "view()",
            "animation-range": "cover 0% cover 100%"
          },
          "@keyframes viewport-reveal": {
            "0%": {
              "opacity": "0.15",
              "translate": "0 1rem"
            },
            "20%, 80%": {
              "opacity": "1",
              "translate": "0 0"
            },
            "100%": {
              "opacity": "0.15",
              "translate": "0 -1rem"
            }
          },
          "@media (prefers-reduced-motion: reduce)": {
            ".page-reveal :where(h1, h2, h3, h4, h5, h6, p, li, blockquote, figcaption, a, button, img, picture, video, canvas, svg[role=\"img\"], [data-slot=\"badge\"], [data-slot=\"button\"], [data-slot=\"card\"], [data-slot=\"liquid-metal-card\"], [data-slot=\"card-title\"], [data-slot=\"card-description\"], [data-slot=\"card-content\"], [data-slot=\"item\"], [data-slot=\"item-media\"], [data-slot=\"item-title\"], [data-slot=\"item-description\"], [data-slot=\"avatar\"], [data-slot=\"avatar-image\"], [data-slot=\"avatar-badge\"], [data-slot=\"accordion-trigger\"], [data-slot=\"accordion-content\"], [data-slot=\"switch\"], [data-slot=\"kbd\"], [data-slot=\"frost-glass\"], [data-slot=\"shiny-text\"], [data-slot=\"electric-border\"], [data-slot=\"contribution-graph\"], [data-slot=\"contribution-graph-calendar\"], [data-slot=\"contribution-graph-footer\"], [data-slot=\"preference-group\"], [data-slot=\"preference-bar\"], [data-slot=\"preference-item\"])": {
              "animation": "none"
            }
          }
        }
      },
      "docs": "Wrap the page or section you want to animate with className=\"page-reveal\". The animation is scroll-driven: children fade and lift in during the first 20% of their viewport overlap, remain steady through the middle, and fade/lift out near the end."
    },
    {
      "name": "animated-headline",
      "type": "registry:component",
      "title": "Animated Headline",
      "description": "A headline that reveals word-by-word with a 3D flip-up, rotates its last word on a timer, and draws a gradient shimmer underline that resizes to each word and replays on every swap. A recreation of the x.ai hero effect.",
      "files": [
        {
          "path": "components/animated-headline.tsx",
          "type": "registry:component",
          "target": "components/animated-headline.tsx"
        },
        {
          "path": "components/animated-headline/constants.ts",
          "type": "registry:file",
          "target": "components/animated-headline/constants.ts"
        },
        {
          "path": "components/animated-headline/use-prefers-reduced-motion.ts",
          "type": "registry:file",
          "target": "components/animated-headline/use-prefers-reduced-motion.ts"
        },
        {
          "path": "components/animated-headline/rotate-appearance.tsx",
          "type": "registry:component",
          "target": "components/animated-headline/rotate-appearance.tsx"
        },
        {
          "path": "components/animated-headline/rotate-word.tsx",
          "type": "registry:component",
          "target": "components/animated-headline/rotate-word.tsx"
        },
        {
          "path": "components/animated-headline/shiny-underline.tsx",
          "type": "registry:component",
          "target": "components/animated-headline/shiny-underline.tsx"
        }
      ],
      "css": {
        "@keyframes hero-word-reveal": {
          "from": {
            "opacity": "0",
            "transform": "translateY(45%) rotateX(-40deg)"
          },
          "to": {
            "opacity": "1",
            "transform": "translateY(0) rotateX(0)"
          }
        },
        "@keyframes hero-word-enter": {
          "from": {
            "opacity": "0",
            "transform": "translateY(100%)"
          },
          "to": {
            "opacity": "1",
            "transform": "translateY(0)"
          }
        },
        "@keyframes hero-word-exit": {
          "from": {
            "opacity": "1",
            "transform": "translateY(0)"
          },
          "to": {
            "opacity": "0",
            "transform": "translateY(-100%)"
          }
        },
        "@keyframes hero-underline-reveal": {
          "from": {
            "opacity": "0",
            "transform": "scaleX(0)"
          },
          "to": {
            "opacity": "1",
            "transform": "scaleX(1)"
          }
        },
        "@keyframes hero-underline-shimmer": {
          "from": {
            "background-position": "100% 50%"
          },
          "to": {
            "background-position": "0% 50%"
          }
        }
      },
      "docs": "Render <AnimatedHeadline prefix=\"Engineering things people love to\" words={[\"build\", \"design\", \"ship\", \"use\"]} /> for the composed effect, or import the named pieces <RotateAppearance />, <RotateWord />, and <ShinyUnderline /> separately. All animation is CSS-owned: prefix words flip up with keyframes, the rotating word uses CSS enter/exit keyframes while React briefly keeps the exiting word rendered, and the underline uses CSS reveal/shimmer keyframes. Honours prefers-reduced-motion by rendering the settled state. Requires the hero-word and hero-underline keyframes (installed automatically via the css field)."
    }
  ]
}
